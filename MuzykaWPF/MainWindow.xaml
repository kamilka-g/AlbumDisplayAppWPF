<Window x:Class="MuzykaWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MuzykaWPF"
        mc:Ignorable="d"
        Title="My Sounds" Height="305" Width="1030" Background="SeaGreen">
    <Grid>
        <Button x:Name="NextButton" HorizontalAlignment="Left" Margin="910,104,0,0" VerticalAlignment="Top" Height="70" Width="90" Click="NextButton_Click">
            <Button.Background>
                <ImageBrush ImageSource="/obraz2.png"/>
            </Button.Background>
        </Button>
        <Button x:Name="PreviousButton" HorizontalAlignment="Left" Margin="30,104,0,0" VerticalAlignment="Top" Height="70" Width="90" Click="PreviousButton_Click">
            <Button.Background>
                <ImageBrush ImageSource="/obraz3.png"/>
            </Button.Background>
        </Button>
        <Image Source="/obraz.png" Margin="85,19,640,95"/>

        <TextBlock x:Name="ArtistText" Text="Gorillaz" Margin="354,47,136,164" FontSize="50" Foreground="white"/>
        <TextBlock x:Name="TitleText" Text="&quot;The Now Now&quot;" Margin="345,106,145,105" FontSize="30" Foreground="white" FontStyle="Italic"/>
        <TextBlock x:Name="SongCountText" Text="11 songs" Margin="350,149,140,62" FontSize="20" Foreground="LightGreen"/>
        <TextBlock x:Name="ReleaseYearText" Margin="485,151,290,50" FontSize="20" Foreground="LightGreen">
            <Run Language="pl-pl" Text="2018"/>
            <LineBreak/>
        </TextBlock>
        <TextBlock x:Name="DownloadsText" Text="11000102" Margin="165,215,520,21" FontSize="20" Foreground="LightGreen"/>

        <Button x:Name="DownloadButton" Content="Download" Margin="315,209,575,25" Foreground="Black" Background="#61D918" FontWeight="Bold" FontSize="20" Click="DownloadButton_Click"/>
    </Grid>
</Window>
